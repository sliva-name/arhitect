# Database Configuration (PostgreSQL)
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Meilisearch (Laravel Scout)
# Use a strong key in production (at least 16 bytes)
MEILI_MASTER_KEY=masterKeyChangeMe

# Storefront / API
FRONTEND_URL=http://localhost:8080
# Empty = same-origin via Nuxt Nitro proxy (/api, /sanctum)
NUXT_PUBLIC_API_BASE=
NUXT_API_INTERNAL=http://backend:8000

# YooKassa (leave empty for sandbox checkout)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8080/checkout/success
# Local: false so you can POST webhooks manually. Production: true.
YOOKASSA_WEBHOOK_VERIFY_IP=false
# Auto-true when shop credentials are empty; set false to forbid sandbox in prod.
YOOKASSA_SANDBOX_ENABLED=true

# User ID and Group ID for file permissions
USER_ID=1000
GROUP_ID=1000

# Environment: development or production
# Change to "production" for production deployment
ENVIRONMENT=development

# Production settings (only used when ENVIRONMENT=production)
# PROD_DOMAIN=yourdomain.com
# PROD_EMAIL=your-email@example.com

# Backup settings (only used in production)
# BACKUP_SCHEDULE=0 2 * * *  # Cron schedule (default: daily at 2 AM)
# BACKUP_RETENTION_DAYS=7    # Keep backups for N days (default: 7)
